# ==============================================================================
# Unified Media Search & Seedbox Control Plane - Environment Configuration
# ==============================================================================

# Application & Server
HOST=127.0.0.1
PORT=8888
APP_BIND_HOST=127.0.0.1
DEBUG=false
DOMAIN=example.com
PUBLIC_BASE_URL=https://media.example.com
# Optional WebAuthn overrides (WEBAUTHN_RP_ID defaults to PUBLIC_BASE_URL hostname or localhost)
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Muuvies
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
FERNET_KEY=change-this-to-a-valid-fernet-key-or-leave-blank-to-auto-generate

# Registration & Email Verification (Resend REST API)
# Keep ALLOW_REGISTRATION=false in production unless paired with ALLOWED_EMAILS / REGISTRATION_INVITE_CODE
ALLOW_REGISTRATION=false
REGISTRATION_INVITE_CODE=
ALLOWED_EMAILS=you@example.com
ADMIN_EMAIL=admin@example.com
RESEND_API_KEY=
EMAIL_FROM="Muuvies <noreply@mail.example.com>"
REQUIRE_EMAIL_VERIFICATION=false

# Authentication & Adult Vault
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
VAULT_PIN=change-me
SESSION_EXPIRE_HOURS=24
VAULT_TIMEOUT_MINUTES=30
COOKIE_SECURE=true

# AI Providers (Google Gemini, Azure OpenAI, GitHub Models)
# AI_PROVIDER accepts: auto, gemini, azure, github, none
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/proj-default
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# 4K Theater Streaming (Jellyfin HLS remux + optional mounted media root)
JELLYFIN_URL=https://your.seedbox.example/your_seedbox_user/jellyfin
JELLYFIN_API_KEY=
STREAM_MEDIA_ROOT=/home/your_seedbox_user/media

# Seedbox Connection & autossh Tunnel Details
SEEDBOX_HOST=your.seedbox.example
SEEDBOX_USER=your_seedbox_user
SEEDBOX_SSH_PORT=22
SEEDBOX_INTERNAL_HOST=127.0.0.1
QB_PORT=8080
PROWLARR_PORT=9696
WHISPARR_PORT=6969
RADARR_REMOTE_PORT=7878
SONARR_REMOTE_PORT=8989

# Service Endpoints (multiplexed via autossh tunnel on localhost)
QBITTORRENT_URL=http://127.0.0.1:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=change-me

PROWLARR_URL=http://127.0.0.1:9696
PROWLARR_API_KEY=your_prowlarr_api_key_here

RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=your_radarr_api_key_here
RADARR_ROOT_FOLDER=/home/your_seedbox_user/media/Movies

SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=your_sonarr_api_key_here
SONARR_ROOT_FOLDER="/home/your_seedbox_user/media/TV Shows"

WHISPARR_URL=http://127.0.0.1:6969
WHISPARR_API_KEY=your_whisparr_api_key_here
WHISPARR_ROOT_FOLDER=/home/your_seedbox_user/media/adult

CROSS_SEED_URL=http://127.0.0.1:2468
CROSS_SEED_API_KEY=your_cross_seed_api_key_here

# Optional Tracker Scoring & Adult Vault Preview Configuration
# PRIVATE_TRACKERS=my-private-tracker
# ADULT_INDEXER_KEYWORDS=
# ADULT_PREVIEW_SOURCES_JSON=
# ADULT_PREVIEW_IMAGE_HOSTS=
# ADULT_PREVIEW_IMAGE_SUBDOMAIN_HOSTS=

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///data/media_search.db

# Optional Observability & Landing Metadata
SENTRY_DSN=
TMDB_READ_ONLY_API_KEY=
